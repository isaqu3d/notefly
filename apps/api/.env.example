NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Docker PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notely?schema=public"

# JWT Configuration
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production-use-different-strong-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
